# Generic template: copy without .example and adapt domain, certificate and paths.
server {
    listen 80;
    listen [::]:80;
    server_name travel.example.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/travel/acme; }
    location / { return 301 https://travel.example.com$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name travel.example.com;
    ssl_certificate /etc/letsencrypt/live/travel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/travel.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    root /var/www/travel/current;
    index index.html;
    autoindex off;
    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    limit_conn travel_connections 20;
    limit_req_status 429;
    limit_conn_status 429;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tiles.openfreemap.org; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' data: https://tiles.openfreemap.org; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    location = /api/login {
        limit_req zone=travel_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8078;
        include /etc/nginx/snippets/travel-proxy.conf;
    }
    location = /api/invite-login {
        limit_req zone=travel_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8078;
        include /etc/nginx/snippets/travel-proxy.conf;
    }
    location ~ ^/api/trips/[a-f0-9-]+/map-pack$ {
        limit_req zone=travel_map_jobs burst=2 nodelay;
        proxy_pass http://127.0.0.1:8078;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 210s;
        proxy_send_timeout 15s;
        proxy_hide_header X-Powered-By;
    }
    location /api/ {
        limit_req zone=travel_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8078;
        include /etc/nginx/snippets/travel-proxy.conf;
    }
    location /map-assets/ {
        limit_req zone=travel_map_assets burst=100 nodelay;
        limit_except GET HEAD { deny all; }
        resolver 127.0.0.53 ipv6=off valid=300s;
        resolver_timeout 3s;
        set $travel_map_host tiles.openfreemap.org;
        set $travel_map_cache_key $uri;
        rewrite ^/map-assets/(.*)$ /$1 break;
        proxy_pass https://$travel_map_host;
        proxy_ssl_server_name on;
        proxy_ssl_name tiles.openfreemap.org;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_set_header Host tiles.openfreemap.org;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_cache travel_map_cache;
        proxy_cache_key $travel_map_cache_key;
        proxy_cache_valid 200 1h;
        proxy_cache_valid 404 30s;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Report-To;
        proxy_hide_header Nel;
        proxy_hide_header Alt-Svc;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
    }
    location ~ "^/map-packs/([a-f0-9]{64}\.pmtiles)$" {
        alias /var/cache/travel/maps/$1;
        default_type application/octet-stream;
        limit_except GET HEAD { deny all; }
        expires 30d;
    }
    location /map-packs/ { return 404; }
    location = /manifest.webmanifest { default_type application/manifest+json; try_files $uri =404; expires -1; }
    location /assets/ { try_files $uri =404; expires 1y; }
    location ~ /\. { deny all; }
    location / { try_files $uri $uri/ /index.html; expires -1; }
    access_log /var/log/nginx/travel.access.log;
    error_log /var/log/nginx/travel.error.log warn;
}
