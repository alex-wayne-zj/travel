# Generic template: copy without .example and adapt domain, certificate and paths.
[Unit]
Description=Travel private itinerary API
After=network.target

[Service]
Type=simple
User=travel
Group=travel
WorkingDirectory=/var/lib/travel
EnvironmentFile=/etc/travel/travel.env
Environment=TOKIO_WORKER_THREADS=2
ExecStart=/opt/travel/current/travel-backend
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/travel /var/cache/travel/maps
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=220M
TasksMax=64
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
